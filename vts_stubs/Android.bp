// Stub defaults and module definitions for minimal TWRP builds.
// The platform/test/vts, platform/cts, packages/modules/NetworkStack, and other
// projects are removed from the minimal manifest, but many Android.bp files in
// remaining projects still reference these modules. These empty stubs satisfy
// those references.

cc_defaults {
    name: "VtsHalDriverDefaults",
    // Intentionally empty — stub to satisfy build dependencies
}

cc_defaults {
    name: "VtsHalProfilerDefaults",
    // Intentionally empty — stub to satisfy build dependencies
}

cc_defaults {
    name: "vts_proto_fuzzer_default",
    // Intentionally empty — stub to satisfy build dependencies
}

cc_defaults {
    name: "cts_defaults",
    // Intentionally empty — stub to satisfy build dependencies
}

java_library {
    name: "libnetworkstackutilsjni_deps",
    // Intentionally empty — stub to satisfy build dependencies
}